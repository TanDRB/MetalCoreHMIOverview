@{
    // Thêm giao diện mới: chỉ cần thêm một dòng vào danh sách này. Id = số máy (chỉ dùng cho trang Machine).
    var pages = new List<(string Action, int? Id, string Title, string Short)>
    {
        ("Index",     null, "Metalcore HMI Overview", "MetalCore  Overview"),
        ("Viscosity", null, "Viscosity Controller Overview", "Viscosity"),
    };
    for (var i = 1; i <= 8; i++)
    {
        pages.Add(("Machine", i, $"Sơn gang cầu #{i:00}", $"MetalCore #{i:00}"));
    }

    var current = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";
    var currentId = int.TryParse(ViewContext.RouteData.Values["id"]?.ToString(), out var cid) ? cid : 1;
    bool IsActive((string Action, int? Id, string Title, string Short) p) =>
        p.Action.Equals(current, StringComparison.OrdinalIgnoreCase) && (p.Id == null || p.Id == currentId);
    var currentTitle = pages.Where(IsActive).Select(p => p.Short).FirstOrDefault() ?? "Chọn giao diện";
}
<div class="screen-menu" id="screen-menu">
    <button type="button" class="screen-menu-btn" aria-haspopup="listbox" aria-expanded="false">
        <svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>
        <span class="screen-menu-cur">@currentTitle</span>
        <svg class="ico caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <ul class="screen-menu-list" role="listbox">
        @foreach (var p in pages)
        {
            var active = IsActive(p);
            <li role="option" aria-selected="@(active ? "true" : "false")">
                <a asp-controller="Home" asp-action="@p.Action" asp-route-id="@p.Id" class="@(active ? "active" : "")">@p.Title</a>
            </li>
        }
    </ul>
</div>
